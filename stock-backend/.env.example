# Optional. Without it the service serves deterministic synthetic data so the
# demo always runs. With it, prices + day %-change are live from Finnhub and the
# NYSE roster comes from Finnhub's symbol endpoint.
#
#   export FINNHUB_API_KEY=your_finnhub_key
#
# Free key: https://finnhub.io/  (60 calls/min is plenty for this demo)
FINNHUB_API_KEY=
